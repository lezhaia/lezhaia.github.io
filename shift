<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- 引入font-awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.0/css/all.min.css" rel="stylesheet" type="text/css">
  <link rel="icon" type="image/png" href="https://www.szmc.edu.tw/Content/images/logo.jpg">
  <title>樹人應英技術實習時數線上平台</title>
  <style>
    * {
      box-sizing: border-box;
      
      font-family: "Noto Sans TC", sans-serif;
    }
    body {
      background-image: url(https://meee.com.tw/R4RvBJA.jpg);
      background-repeat: no-repeat;
      background-attachment: fixed;
      background-position: center;
      background-size: cover;
      margin: 0;
    }
    .card {
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      max-width: 480px;
      margin: 40px auto;
      overflow: hidden;
    }
    .banner-wrapper {
      position: relative;
      height: 240px;
    }
    .banner {
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.55;
    }
    .watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 240px;
      pointer-events: none;
    }
    .content {
      padding: 20px 30px;
    }
    h2 {
      text-align: center;
      color: #1f2937;
      margin-bottom: 20px;
    }
    label {
      display: block;
      margin-top: 16px;
      color: #374151;
      font-weight: bold;
    }
    input {
      width: 100%;
      padding: 10px;
      margin-top: 6px;
      border-radius: 8px;
      border: 1px solid #d1d5db;
      outline: none;
      transition: border 0.2s ease;
    }
    input:focus {
      border: 1px solid #8E0000;
    }
    .badge {
      display: inline-block;
      padding: 4px 10px;
      font-size: 12px;
      color: white;
      background-color: #8E0000;
      border-radius: 20px;
      margin-bottom: 10px;
    }
    .card-info {
      background: #f9fafb;
      border-radius: 12px;
      padding: 15px;
      margin-bottom: 20px;
      box-shadow: 0 0 0 1px #e5e7eb;
    }
    .summary-row {
      display: flex;
      justify-content: space-between;
      padding: 4px 0;
      font-size: 15px;
    }
    .progress-bar-wrapper {
      margin-top: 10px;
      background: #e5e7eb;
      border-radius: 10px;
      overflow: hidden;
      height: 14px;
    }
    .progress-bar {
      background: #8E0000;
      height: 100%;
      width: 0%;
      transition: width 0.5s ease;
    }
    .btn-group {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-top: 20px;
      flex-wrap: wrap;
      margin-bottom: 10px;
    }
    .btn-login {
      display: flex;
      justify-content: center;
      margin-top: 20px;
    }
    .btn-group button,
    .btn-logout button,
    .btn-login button {
      border: 1px solid #8E0000;
      border-radius: 8px;
      background-color: white;
      color: #8E0000;
      font-size: 16px;
      padding: 10px 20px;
      cursor: pointer;
      transition: all 0.3s ease;
      min-width: 100px;
    }
    .btn-group button:hover,
    .btn-logout button:hover,
    .btn-login button:hover {
      background-color: #8E0000;
      color: white;
    }
    #message {
      text-align: center;
      font-weight: bold;
      margin-top: 10px;
    }
    #clock {
      text-align: center;
      font-size: 14px;
      color: #6b7280;
      margin-top: 20px;
    }
    footer {
      text-align: center;
      font-size: 12px;
      color: #9ca3af;
      margin-top: 20px;
    }
    #loading-overlay {
      display: none;
      position: fixed;
      z-index: 99;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background-color: rgba(255, 255, 255, 0.7);
      justify-content: center;
      align-items: center;
    }
    .spinner {
      width: 50px;
      height: 50px;
      border: 6px solid #d1d5db;
      border-top-color: #8E0000;
      border-radius: 50%;
      animation: spin 0.9s linear infinite;
    }
    .alert-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.4);
      z-index: 999;
      display: none;
      justify-content: center;
      align-items: center;
    }
    .alert-box {
      background: #fff;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 6px 24px rgba(0,0,0,0.2);
      max-width: 300px;
      text-align: center;
      position: relative;
    }
    .alert-box .icon {
      font-size: 48px;
      color: #ef4444;
      margin-bottom: 10px;
    }
    .alert-box .title {
      font-size: 20px;
      font-weight: bold;
      margin-bottom: 8px;
    }
    .alert-box .text {
      font-size: 15px;
      color: #374151;
      margin-bottom: 16px;
    }
    .alert-box button {
      padding: 8px 20px;
      background: #8E0000;
      color: #fff;
      border: none;
      border-radius: 6px;
      cursor: pointer;
    }
    .scan-barcode {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      font-size: 16px;
      font-weight: bold;
      color: #8E0000;
      cursor: pointer;
      margin-bottom: 12px;
    }
    #reader {
      width: 100%;
      margin-top: 10px;
      display: none;
    }
    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }
    @media (max-width: 600px) {
      .content {
        padding: 16px;
      }
      .btn-group button,
      .btn-logout button,
      .btn-login button {
        font-size: 15px;
        padding: 10px 16px;
      }
    }
  </style>
</head>
<body>
    <div id="alert" class="alert-overlay">
        <div class="alert-box">
          <div class="icon" id="alert-icon">❌</div>
          <div class="title" id="alert-title">出事了阿北</div>
          <div class="text" id="alert-text">警告：車輛提早抵達田中</div>
          <button onclick="hideAlert()">OK</button>
        </div>
      </div>

    <div id="loading-overlay"><div class="spinner"></div></div>
    <div class="card">
      <div class="banner-wrapper">
        <img src="https://meee.com.tw/72P8Us5.jpg" class="banner" alt="banner" />
        <!-- <img src="https://test-ct5ming.ctcm.org.tw/assets/dasn//images/logo.png?v=1" class="watermark" alt="watermark" /> -->
      </div>
      <div class="content">
        <h2>SZMC Dept. of Applied English <br>Internship Hours Portal</h2>

  
        <div id="login-block">
          <form id="loginForm" onsubmit="event.preventDefault(); login();">
            <label for="volunteerId">Sign in</label>
            <input type="text" id="volunteerId" placeholder="Enter your SZMC ID" required />
          </form>
        <div class="content">
            <div class="scan-barcode" onclick="startScan()">
              <i class="fas fa-barcode"></i> 點我掃描條碼
            </div>
            <div id="reader"></div>

            
          <div class="btn-login">
            <button onclick="login()">Login</button>
          </div>
        </div>
  
        <div id="user-info" style="display:none;"></div>
  
        <div class="btn-group" style="display:none;">
          <button onclick="clockIn()">Start Shift</button>
          <button onclick="clockOut()">End Shift</button>
          <button onclick="logout()">Logout</button>
        </div>
  
        <div id="message" style="color: #10b981; text-align:center; margin-top:10px;"></div>
        <div id="clock">目前時間：</div>
        <footer>© 2025 SZMC Dept.of Applied English. All rights reserved.</footer>
      </div>
    </div>
    <script>
      const scriptURL = "https://script.google.com/macros/s/AKfycbzpln81owcQGI_darWtZYiK4NlQde1sZg3oP02A2z1pfbqqjKwJWCVB_d84jdodokiZ6Q/exec";
      let clientIP = '';
      let currentUserId = null;
      let scannerActive = false;    
      
  
      fetch('https://api.ipify.org?format=json')
        .then(res => res.json())
        .then(data => clientIP = data.ip);

        function startScan() {
        const reader = document.getElementById("reader");
        if (!scannerActive) {
        reader.style.display = "block";
        const html5QrCode = new Html5Qrcode("reader");
        scannerActive = true;
        html5QrCode.start(
        { facingMode: "environment" },
        { fps: 10, qrbox: 250 },
        qrCodeMessage => {
          document.getElementById("volunteerId").value = qrCodeMessage;
          html5QrCode.stop();
          reader.style.display = "none";
          scannerActive = false;
        },
        errorMessage => {
          // 可選擇性顯示錯誤 console.log(errorMessage);
        }
      ).catch(err => {
        showAlert("error", "Camera Error", "無法啟用掃描器: " + err);
        scannerActive = false;
      });
    }
  }
  
      function showLoading() {
        document.getElementById("loading-overlay").style.display = "flex";
      }
      function hideLoading() {
        document.getElementById("loading-overlay").style.display = "none";
      }
  
      function login(keepId = false) {
        const idInput = document.getElementById("volunteerId");
        const id = keepId ? currentUserId : idInput.value.trim();
        const msg = document.getElementById("message");
  
        if (!id) {
          showAlert("error", "Error", "Account field is required.");
          msg.textContent = "Please enter your SZMC ID";
          msg.style.color = "#ef4444";

          return;
        }
  
        showLoading();
  
        fetch(`${scriptURL}?id=${id}&action=login&ip=${clientIP}`)
          .then(res => res.json())
          .then(data => {
            hideLoading();
            if (data.status === "success") {
              currentUserId = id;
              if (!keepId) idInput.value = "";
              document.getElementById("login-block").style.display = "none";
  
              const categoryMap = {
                business: "商業模組 Business Module",
                teaching: "教學模組 Teaching Module",
                tourism: "觀光模組 Toursim Module"
              };
              const categoryName = categoryMap[data.category] || "未知模組";
  
              document.getElementById("user-info").style.display = "block";
              document.getElementById("user-info").innerHTML = generateUserCard(categoryName, data.name, data.currentHours, data.remainingHours);
  
              document.querySelector(".btn-group").style.display = "flex";
              showAlert("success", "Welcome!", "Successfully logged in.");
              msg.textContent = "Status : Successfully logged in.";
              msg.style.color = "#10b981";
            } else {
              msg.textContent = data.message || "狀態 : 查無此帳號";
              msg.style.color = "#ef4444";
            }
          })
          .catch(err => {
            hideLoading();
            showAlert("error", "System", "Unable to log in. Please try again later.");
            msg.textContent = "狀態 : 登入失敗，請稍後再試";
            msg.style.color = "#ef4444";
          });
      }

      function showAlert(type, title, text) {
      const iconMap = {
        error: '❌',
        success: '✅',
        warning: '⚠️',
        info: 'ℹ️',
        question: '❔'
      };
      document.getElementById("alert-icon").textContent = iconMap[type] || '❔';
      document.getElementById("alert-title").textContent = title;
      document.getElementById("alert-text").textContent = text;
      document.getElementById("alert").style.display = "flex";
    }

    function hideAlert() {
      document.getElementById("alert").style.display = "none";
    }
  
      function generateUserCard(categoryName, name, currentHours, remainingHours) {
        return `
          <div class="badge">${categoryName}</div>
          <div class="card-info">
            <div style="font-size: 20px; font-weight: bold; margin-bottom: 6px;">
              Welcome，<span style="color:#8E0000">${name}</span> !
            </div>
            <div>Choose an action below.</div>
            <hr style="margin:12px 0;" />
            <div class="summary-row">
              <span>Currently Completed...</span>
              <strong style="color: #8E0000">${currentHours} Hours</strong>
            </div>
            <div class="summary-row">
              <span>Hours Remaining...</span>
              <strong style="color: #8E0000">${remainingHours} Hours</strong>
            </div>
            <div class="progress-bar-wrapper">
              <div class="progress-bar" style="width: ${Math.min(100, (parseFloat(currentHours) / 40) * 100)}%;"></div>
            </div>
          </div>
        `;
      }
  
      function logout() {
        currentUserId = null;
        document.getElementById("login-block").style.display = "block";
        document.getElementById("user-info").style.display = "none";
        document.querySelector(".btn-group").style.display = "none";
        document.getElementById("message").textContent = "";
        showAlert("success", "System", "You have logged out.")
      }
  
      function sendData(action) {
        const msg = document.getElementById("message");
        if (!currentUserId) {
          msg.textContent = "請先登入";
          msg.style.color = "#ef4444";
          return;
        }
  
        showLoading();
        fetch(`${scriptURL}?id=${currentUserId}&action=${action}&ip=${clientIP}`)
          .then(res => res.text())
          .then(response => {
            hideLoading();
            msg.textContent = response;
            msg.style.color = response.includes("禁止") ? "#ef4444" : "#10b981";
          })
          .catch(err => {
            hideLoading();
            msg.textContent = "操作失敗，請稍後再試";
            msg.style.color = "#ef4444";
          });
      }
      
  
      function clockIn() { sendData("start"); showAlert("question", "System", "Are you sure you want to proceed?"); }
      function clockOut() { sendData("end"); showAlert("question", "System", "Are you sure you want to proceed?"); }
  
      function updateClock() {
        const now = new Date();
        const formattedTime = now.toLocaleString("zh-TW", {
          year: "numeric", month: "2-digit", day: "2-digit",
          hour: "2-digit", minute: "2-digit", second: "2-digit",
          hour12: false
        });
        document.getElementById("clock").textContent = "Current Time: " + formattedTime;
      }
      setInterval(updateClock, 1000);
      updateClock();
    </script>
</body>
</html>
